# ============================================================
#  RY GROUP — Owntown Farming Bot — Environment Template
#  Copy to .env and fill in. NEVER commit your real .env.
# ============================================================

# ── REQUIRED ────────────────────────────────────────────────
# Your Solana wallet private key (base58, 32-byte seed OR 64-byte secret key).
# This is what the installer calls your "passphrase". KEEP IT SECRET.
WALLET_PRIVATE_KEY=your_base58_private_key_here

# Telegram bot token from @BotFather (e.g. 123456789:AA....).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── OPTIONAL (sensible defaults; leave blank to auto-handle) ─
# Wallet address — auto-derived from the private key if left blank.
WALLET_ADDRESS=
# Telegram chat id — auto-learned the first time you message the bot.
TELEGRAM_CHAT_ID=
# Player id — auto-detected after connect.
MY_PLAYER_ID=

# ── BEHAVIOUR ───────────────────────────────────────────────
GAME_HOST=owntown.fun
REPORT_INTERVAL_MIN=30
# true = only profit/important Telegram notifications (mute routine chatter)
NOTIFY_PROFIT_ONLY=true

# Anti-detection schedule: human-like online/offline pattern.
SCHEDULE_ENABLED=true
SCHEDULE=on:18,off:2,on:1,off:3
SCHEDULE_JITTER_PCT=12

# ── TRADING / FLIP STRATEGY (measured, not reckless) ────────
FLIP_ENABLED=true
FLIP_MAX_COST=1000
FLIP_COOLDOWN_SEC=60
FLIP_UNDERPRICE=0.45
FLIP_MIN_PROFIT=150
BALANCE_RESERVE=5000
DAILY_BUY_CAP=3000
POWERUP_ENABLED=true

# ── SYSTEM ──────────────────────────────────────────────────
WATCHDOG_STUCK_MIN=5
LOG_PATH=/tmp/owntown_v25.log
TOKEN_PATH=/tmp/owntown_token.txt
